<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_host" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_tva_light">
<TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
<TextView android:id="@+id/widget_transition" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
<TextView android:id="@+id/widget_empty" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
<LinearLayout android:id="@+id/widget_focus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:id="@+id/focus_header" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
<ImageView android:id="@+id/focus_power_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="4dp" android:scaleType="fitCenter" />
<TextView android:id="@+id/focus_address" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" />
<TextView android:id="@+id/focus_configure" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_more" android:textSize="20sp" android:contentDescription="@string/widget_configure" />
</LinearLayout>
<LinearLayout android:id="@+id/focus_event" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/focus_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2"  />
<TextView android:id="@+id/focus_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2"  />
<TextView android:id="@+id/focus_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:fontFamily="sans-serif-light" />
<TextView android:id="@+id/focus_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2"  />
</LinearLayout>
<TextView android:id="@+id/focus_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:visibility="gone" />
</LinearLayout></LinearLayout></FrameLayout>
